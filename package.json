{
  "name": "turn-model-free",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "description": "本机模型账号管理与 OpenAI 兼容 API 网关，提供原创桌面控制台、账号与配额展示，支持桌面和网页两种启动方式；插件渠道基于 dsh-our-free-model。",
  "scripts": {
    "extract": "node scripts/extract.mjs && node scripts/extract-theme.mjs",
    "extract:guard": "node scripts/merge-guard.mjs",
    "check:drift": "node scripts/extract.mjs --check && node scripts/extract-theme.mjs --check && node scripts/merge-guard.mjs --check",
    "demo": "node scripts/build-demo.mjs",
    "check:demo": "node scripts/build-demo.mjs --check",
    "test": "node scripts/test-all.mjs",
    "test:guard": "node src/test/run.mjs src/test/guard.test.mjs",
    "test:native": "node src/test/run.mjs src/test/native-response.test.mjs",
    "test:guard-demo": "node src/test/run.mjs src/test/guard-demo.test.mjs",
    "test:parity": "node src/test/run.mjs src/test/parity.test.mjs",
    "test:behaviour": "node src/test/run.mjs src/test/behaviour.test.mjs",
    "test:demo": "node src/test/run.mjs src/test/demo.test.mjs",
    "test:provenance": "node src/test/run.mjs src/test/provenance.test.mjs",
    "verify": "node scripts/test-all.mjs --with-drift"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "scheduler": "0.27.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
